{
  "name": "frd/math-utils",
  "description": "PHP library for mathematical operations including median, average, sum, and formula processing",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Flying Rubber Duck",
      "email": "info@flyingrubberduck.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Frd\\MathUtils\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Frd\\MathUtils\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
