{
    "name": "kachnitel/math-utils",
    "description": "PHP library for mathematical operations including median, average, sum, and formula processing",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ondrej Vana",
            "email": "vana.ondrej@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "marcocesarato/php-conventional-changelog": "dev-fix/symfony-console-7-compat"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kachnitel/php-conventional-changelog"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kachnitel\\MathUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kachnitel\\MathUtils\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "release": ".scripts/release.sh"
    },
    "version": "1.0.0"
}